rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is supervisor or above
    function isSupervisorOrAbove() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole in ['supervisor', 'manager', 'coo', 'director'];
    }
    
    // Helper function to check if user is manager or above
    function isManagerOrAbove() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole in ['manager', 'coo', 'director'];
    }
    
    // Helper function to check if user is COO or director
    function isCOOOrDirector() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole in ['coo', 'director'];
    }
    
    // Helper function to check if user is director
    function isDirector() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole == 'director';
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserRole() {
      return currentUser().role;
    }

    function roleLevel(role) {
      return role == 'director' ? 0 :
        role == 'coo' ? 1 :
        role == 'manager' ? 2 :
        role == 'supervisor' ? 3 : 4;
    }

    function canApproveRole(requesterRole) {
      return roleLevel(currentUserRole()) < roleLevel(requesterRole);
    }

    function canCreateUserRole(role) {
      return role in ['staff', 'supervisor', 'manager', 'coo', 'director'] &&
        roleLevel(currentUserRole()) <= roleLevel(role);
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isValidUserCreate() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'role',
          'teamId',
          'areaCode',
          'bonusPoints',
          'bonusAmount',
          'createdAt'
        ]) &&
        isRequiredString(request.resource.data.name) &&
        isRequiredString(request.resource.data.email) &&
        isRequiredString(request.resource.data.phone) &&
        canCreateUserRole(request.resource.data.role) &&
        isNullableString(request.resource.data.teamId) &&
        isNullableString(request.resource.data.areaCode) &&
        request.resource.data.bonusPoints is int &&
        request.resource.data.bonusPoints >= 0 &&
        request.resource.data.bonusAmount is number &&
        request.resource.data.bonusAmount >= 0 &&
        request.resource.data.createdAt is timestamp;
    }

    function isValidApprovalUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'approvalStatus',
          'approvedBy',
          'approvedByEmail',
          'approvedByRole',
          'approvedAt',
          'rejectionReason'
        ]) &&
        request.resource.data.status in ['Approved', 'Rejected'] &&
        request.resource.data.approvalStatus in ['Approved', 'Rejected'] &&
        request.resource.data.status == request.resource.data.approvalStatus &&
        request.resource.data.approvedBy == request.auth.uid &&
        request.resource.data.approvedByRole == currentUserRole();
    }

    function approvedRequest(requestId) {
      return getAfter(/databases/$(database)/documents/material_requests/$(requestId)).data;
    }

    function isApprovedAddMaterialRequest(requestId) {
      let approval = approvedRequest(requestId);
      return approval.action == 'add_material' &&
        approval.status == 'Approved' &&
        approval.approvedBy == request.auth.uid &&
        canApproveRole(approval.requestedByRole);
    }

    function isValidApprovedMaterialCreate(requestId) {
      let approval = approvedRequest(requestId);
      return isApprovedAddMaterialRequest(requestId) &&
        request.resource.data.keys().hasOnly([
          'materialName',
          'materialCode',
          'category',
          'quantity',
          'unit',
          'unitPrice',
          'totalValue',
          'supplier',
          'location',
          'description',
          'status',
          'approvedRequestId',
          'addedBy',
          'addedByEmail',
          'approvedBy',
          'approvedByEmail',
          'timestamp',
          'lastUpdated'
        ]) &&
        request.resource.data.materialName == approval.materialData.materialName &&
        request.resource.data.materialCode == approval.materialData.materialCode &&
        request.resource.data.category == approval.materialData.category &&
        request.resource.data.quantity == approval.materialData.quantity &&
        request.resource.data.unit == approval.materialData.unit &&
        request.resource.data.unitPrice == approval.materialData.unitPrice &&
        request.resource.data.totalValue == approval.materialData.totalValue &&
        request.resource.data.totalValue == request.resource.data.quantity *
          request.resource.data.unitPrice &&
        request.resource.data.supplier == approval.materialData.supplier &&
        request.resource.data.location == approval.materialData.location &&
        request.resource.data.description == approval.materialData.description &&
        request.resource.data.status == 'Available' &&
        request.resource.data.addedBy == approval.requestedBy &&
        request.resource.data.addedByEmail == approval.requestedByEmail &&
        request.resource.data.approvedBy == request.auth.uid;
    }

    function isApprovedWithdrawMaterialRequest(requestId) {
      let approval = approvedRequest(requestId);
      return approval.action == 'withdraw_material' &&
        approval.status == 'Approved' &&
        approval.approvedBy == request.auth.uid &&
        canApproveRole(approval.requestedByRole);
    }

    function isPositiveNumber(value) {
      return value is number && value > 0;
    }

    function isRequiredString(value) {
      return value is string && value.size() > 0;
    }

    function isValidAddMaterialRequest() {
      return request.resource.data.materialData is map &&
        isRequiredString(request.resource.data.materialName) &&
        isRequiredString(request.resource.data.materialCode) &&
        isPositiveNumber(request.resource.data.requestedQuantity) &&
        isRequiredString(request.resource.data.unit) &&
        isRequiredString(request.resource.data.materialData.materialName) &&
        isRequiredString(request.resource.data.materialData.materialCode) &&
        isRequiredString(request.resource.data.materialData.category) &&
        isPositiveNumber(request.resource.data.materialData.quantity) &&
        isRequiredString(request.resource.data.materialData.unit) &&
        request.resource.data.requestedQuantity == request.resource.data.materialData.quantity &&
        request.resource.data.unit == request.resource.data.materialData.unit &&
        request.resource.data.materialName == request.resource.data.materialData.materialName &&
        request.resource.data.materialCode == request.resource.data.materialData.materialCode &&
        request.resource.data.materialData.unitPrice is number &&
        request.resource.data.materialData.unitPrice >= 0 &&
        request.resource.data.materialData.totalValue is number &&
        request.resource.data.materialData.totalValue ==
          request.resource.data.materialData.quantity *
          request.resource.data.materialData.unitPrice &&
        isRequiredString(request.resource.data.materialData.supplier) &&
        isRequiredString(request.resource.data.materialData.location) &&
        request.resource.data.materialData.description is string;
    }

    function isValidWithdrawMaterialRequest() {
      return isRequiredString(request.resource.data.materialId) &&
        isRequiredString(request.resource.data.materialName) &&
        isPositiveNumber(request.resource.data.requestedQuantity) &&
        isRequiredString(request.resource.data.unit) &&
        isRequiredString(request.resource.data.projectCode) &&
        isRequiredString(request.resource.data.purpose) &&
        request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical'] &&
        request.resource.data.requiredDate is timestamp &&
        request.resource.data.remarks is string;
    }

    function isValidMaterialRequestCreate() {
      return request.resource.data.action == 'add_material'
        ? isValidAddMaterialRequest()
        : request.resource.data.action == 'withdraw_material'
          ? isValidWithdrawMaterialRequest()
          : false;
    }
    
    // Auth audit events — append-only log (FR-018, FR-019)
    match /auth_events/{eventId} {
      // Any authenticated user can create audit events (app writes on their behalf)
      allow create: if request.auth != null
        && request.resource.data.eventType in ['login_success', 'login_failure', 'logout', 'idle_timeout', 'force_logout']
        && request.resource.data.timestamp == request.time;
      
      // Only managers and above can read audit events (admin visibility)
      allow read: if request.auth != null && isManagerOrAbove();
      
      // No updates or deletes — append-only
      allow update, delete: if false;
    }
    
    // App settings — admin-configurable (idle timeout, etc.)
    match /app_settings/{settingId} {
      // All authenticated users can read settings
      allow read: if request.auth != null;
      
      // Only managers and above can create/update settings
      allow create, update: if request.auth != null && isManagerOrAbove();
      
      // Only directors can delete settings
      allow delete: if request.auth != null && isDirector();
    }
    
    // Users collection - role-based access
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      // Supervisors and above can read all users
      allow read: if request.auth != null && isSupervisorOrAbove();
      // Users can update their own profile (limited fields)
      allow update: if request.auth != null && 
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email']);
      // Only managers and above can create users
      allow create: if request.auth != null &&
        isManagerOrAbove() &&
        isValidUserCreate();
      // Only managers and above can delete users
      allow delete: if request.auth != null && isManagerOrAbove();
    }
    
    // Attendance collection - flat structure
    match /attendance/{attendanceId} {
      // Users can read their own attendance
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Supervisors and above can read all attendance
      allow read: if request.auth != null && isSupervisorOrAbove();
      // Users can create their own attendance (only once per day)
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.date.toMillis() == request.time.date().toMillis();
      // Supervisors can update attendance status
      allow update: if request.auth != null && 
        isSupervisorOrAbove() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedBy']);
      // Managers and above can delete attendance
      allow delete: if request.auth != null && isManagerOrAbove();
    }
    
    // Teams collection
    match /teams/{teamId} {
      // Supervisors and above can read teams
      allow read: if request.auth != null && isSupervisorOrAbove();
      // Managers and above can create/update/delete teams
      allow create, update, delete: if request.auth != null && isManagerOrAbove();
    }
    
    // Worksheets collection
    match /worksheets/{worksheetId} {
      // Supervisors and above can read all worksheets
      allow read: if request.auth != null && isSupervisorOrAbove();
      // Supervisors can create worksheets
      allow create: if request.auth != null && 
        isSupervisorOrAbove() &&
        request.resource.data.createdBy == request.auth.uid;
      // Creators can update their own pending worksheets
      allow update: if request.auth != null && 
        resource.data.createdBy == request.auth.uid &&
        resource.data.status == 'pending';
      // Managers can approve/reject worksheets
      allow update: if request.auth != null && 
        isManagerOrAbove() &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvedBy']);
      // Managers and above can delete worksheets
      allow delete: if request.auth != null && isManagerOrAbove();
    }
    
    // Materials collection
    match /materials/{materialId} {
      // All authenticated users can read materials
      allow read: if request.auth != null;
      // Materials can only be created as part of approving an add-material request.
      allow create: if request.auth != null &&
        request.resource.data.approvedRequestId is string &&
        isValidApprovedMaterialCreate(request.resource.data.approvedRequestId);
      // Stock can only be decremented as part of approving a withdraw request.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity',
          'lastUpdated',
          'lastApprovedRequestId'
        ]) &&
        request.resource.data.lastApprovedRequestId is string &&
        request.resource.data.quantity == resource.data.quantity -
          approvedRequest(request.resource.data.lastApprovedRequestId).requestedQuantity &&
        isApprovedWithdrawMaterialRequest(request.resource.data.lastApprovedRequestId);
      // Managers and above can delete materials
      allow delete: if request.auth != null && isManagerOrAbove();
    }
    
    // Assets collection
    match /assets/{assetId} {
      // All authenticated users can read assets
      allow read: if request.auth != null;
      // Supervisors and above can create assets
      allow create: if request.auth != null && isSupervisorOrAbove();
      // Managers and above can update/delete assets
      allow update, delete: if request.auth != null && isManagerOrAbove();
    }
    
    // Insurance collection
    match /insurance/{insuranceId} {
      // Users can read their own insurance
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Managers and above can read all insurance
      allow read: if request.auth != null && isManagerOrAbove();
      // Managers and above can create/update insurance
      allow create, update: if request.auth != null && isManagerOrAbove();
      // Only managers and above can delete insurance
      allow delete: if request.auth != null && isManagerOrAbove();
    }
    
    // Bonuses collection
    match /bonuses/{bonusId} {
      // Users can read their own bonuses
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Supervisors and above can read all bonuses
      allow read: if request.auth != null && isSupervisorOrAbove();
      // Supervisors and above can create bonuses
      allow create: if request.auth != null && 
        isSupervisorOrAbove() &&
        request.resource.data.updatedBy == request.auth.uid;
      // Only the person who created can update
      allow update: if request.auth != null && 
        resource.data.updatedBy == request.auth.uid;
      // Managers and above can delete bonuses
      allow delete: if request.auth != null && isManagerOrAbove();
    }
    
    // Cashbook collection (Director only)
    match /cashbook/{cashbookId} {
      // Only directors can read cashbook
      allow read: if request.auth != null && isDirector();
      // COO and Director can create entries
      allow create: if request.auth != null && isCOOOrDirector();
      // Only creator or director can update
      allow update: if request.auth != null && 
        (resource.data.enteredBy == request.auth.uid || isDirector());
      // Only director can delete
      allow delete: if request.auth != null && isDirector();
    }
    
    // Legacy: Allow authenticated users to read/write their own worker profile (for migration)
    match /workers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Old attendance subcollection (deprecated - use flat attendance collection instead)
      match /attendance/{attendanceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Material request approval workflow
    match /material_requests/{requestId} {
      // Allow users to read their own requests
      allow read: if request.auth != null && 
        resource.data.requestedBy == request.auth.uid;
      // Supervisors and above can read requests for approval filtering
      allow read: if request.auth != null && isSupervisorOrAbove();
      // Allow users to create their own requests
      allow create: if request.auth != null && 
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.requestCategory == 'material' &&
        request.resource.data.requestedByRole is string &&
        request.resource.data.requestedByRole == currentUserRole() &&
        request.resource.data.action in ['add_material', 'withdraw_material'] &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.approvalStatus == 'Awaiting Approval' &&
        request.resource.data.approvedBy == null &&
        request.resource.data.approvedByRole == null &&
        request.resource.data.approvedAt == null &&
        request.resource.data.rejectionReason == null &&
        isValidMaterialRequestCreate();
      // Allow users to update their own pending requests
      allow update: if request.auth != null && 
        resource.data.requestedBy == request.auth.uid &&
        resource.data.status == 'Pending' &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'purpose',
          'priority',
          'requiredDate',
          'remarks'
        ]);
      // Only higher authority can approve or reject a request
      allow update: if request.auth != null &&
        canApproveRole(resource.data.requestedByRole) &&
        isValidApprovalUpdate();
    }
    
    // Deny all other requests by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
