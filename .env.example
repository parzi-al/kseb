# Flutter compile-time flags
#
# Pass these with --dart-define when running or building:
# flutter run --dart-define=ENABLE_STAFF_DASHBOARD=true --dart-define=ENABLE_STAFF_DASHBOARD_FOR_MANAGERS_SUPERVISORS=true

# Global switch for showing the Staff Management dashboard card.
# false = hidden for everyone.
# true = enabled, then role-scope rules below apply.
ENABLE_STAFF_DASHBOARD=false

# Role-scope switch for Staff Management.
# false = any supervisor-or-higher user can see it when they have a teamId.
# true = only managers and supervisors can see it when they have a teamId.
ENABLE_STAFF_DASHBOARD_FOR_MANAGERS_SUPERVISORS=false
